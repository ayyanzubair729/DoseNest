# DoseNest server environment variables (copy to .env and fill in locally)

NODE_ENV=development

# Port the API server listens on
PORT=5000

# MongoDB connection string (local default for development)
MONGODB_URI=mongodb://127.0.0.1:27017/dosenest

# JWT signing secret — generate a long random value in production
JWT_SECRET=change_me_in_production

# Access-token lifetime (finite session expiry). JWT_ACCESS_TOKEN_EXPIRES_IN
# is the preferred name; JWT_EXPIRES_IN is kept as a legacy alias.
JWT_ACCESS_TOKEN_EXPIRES_IN=7d
# JWT_EXPIRES_IN=7d

# Frontend inactivity guard (minutes). After this much genuine inactivity the
# client logs the user out; the JWT remains the hard server-side expiry.
# Set to 0 to disable the idle timeout.
SESSION_IDLE_TIMEOUT_MINUTES=60

# Reminder engine: how long after a scheduled time a dose is still "due"
# before it is marked as missed (in minutes)
MEDICATION_MISSED_GRACE_MINUTES=30

# How often the internal reminder job runs (in minutes)
REMINDER_JOB_INTERVAL_MINUTES=1

# Allowed frontend origin for CORS + credentials
CLIENT_URL=http://localhost:5173

# ---------- WhatsApp Cloud API (Phase 7 + Phase 8) ----------
# Provider: Meta WhatsApp Cloud API (official Graph API).
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api
#
# ---------------------------------------------------------------
# LOCAL SIMULATION (no Meta account needed — safe default for development)
# ---------------------------------------------------------------
# WHATSAPP_ENABLED=false + WHATSAPP_TEST_MODE=true runs the full delivery
# pipeline with every send SIMULATED locally: no real provider request is ever
# made, and simulated messages are clearly marked. All other WhatsApp
# variables below can stay empty.
WHATSAPP_ENABLED=false
WHATSAPP_TEST_MODE=true

# ---------------------------------------------------------------
# REAL META WHATSAPP DELIVERY (only when intentionally enabling)
# ---------------------------------------------------------------
# Set WHATSAPP_ENABLED=true and provide real credentials created at
# https://developers.facebook.com (App > WhatsApp > API Setup). Never commit
# real values.
# WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional — not required to send messages; used for other Cloud API calls.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# Delivery behavior
WHATSAPP_MAX_RETRIES=2
WHATSAPP_RETRY_DELAY_MS=2000
WHATSAPP_REQUEST_TIMEOUT_MS=10000

# Pre-approved message templates (names must exist in the WABA console and be
# approved by Meta). Language code follows Cloud API format, e.g. "en".
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_MEDICATION_DUE=medication_due_reminder
WHATSAPP_TEMPLATE_MEDICATION_MISSED=medication_missed_reminder
WHATSAPP_TEMPLATE_MEDICATION_TAKEN=medication_taken_confirmation
WHATSAPP_TEMPLATE_REMINDER=medication_upcoming_reminder
# Template used by the "Send test message" button in REAL mode ({{1}} first name).
WHATSAPP_TEMPLATE_TEST=dosenest_test_message

# ---------------------------------------------------------------
# WEBHOOKS (Phase 8) — required for real Meta webhooks and for local
# webhook simulation
# ---------------------------------------------------------------
# Token echoed during the Meta GET subscription handshake. Use a strong random
# value for real delivery; any dev value works locally.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional — when set, incoming webhook POSTs are verified with
# X-Hub-Signature-256 (HMAC-SHA256 over the raw body). Recommended for real
# delivery; leave empty for local development.
WHATSAPP_APP_SECRET=
# How long after a scheduled dose a "TAKEN" reply is accepted (minutes).
WHATSAPP_TAKEN_CONFIRMATION_WINDOW_MINUTES=90